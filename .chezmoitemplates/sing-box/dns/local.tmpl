"dns": {
    "strategy": "ipv4_only",
    "servers": [
        {
            "type": "hosts",
            "tag": "dns-godke-dev",
            "predefined": {
{{ includeTemplate "sing-box/dns/dns-godke-dev.tmpl" . | indent 16 }}
            }
        },
        {
            "type": "fakeip",
            "tag": "dns-fakeip",
            "inet4_range": "198.18.0.0/15"
        },
        {
            "type": "https",
            "tag": "dns-local",
            "domain_resolver": "dns-local-resolver",
            "server": "dns.alidns.com",
            "path": "/dns-query"
        },
        {
            "type": "udp",
            "tag": "dns-local-resolver",
            "server": "223.5.5.5",
            "server_port": 53
        },
        {
            "type": "tls",
            "tag": "dns-remote",
            "detour": "proxy",
            "domain_resolver": "dns-local-resolver",
            "server": "8.8.8.8",
            "server_port": 853
        }
    ],
    "rules": [
        {
            "rule_set": "godke-dev",
            "server": "dns-godke-dev"
        },
        {
            "rule_set": "category-ads-all",
            "action": "reject"
        },
        {
            "rule_set": "custom-direct",
            "server": "dns-local"
        },
        {
            "rule_set": "custom-proxy",
            "server": "dns-remote"
        },
        {
            "rule_set": [
                "geosite-private",
                "geosite-cn"
            ],
            "server": "dns-local"
        },
        {
            "type": "logical",
            "mode": "and",
            "rules": [
                {
                    "domain_suffix": [
                        ".lan",
                        ".localdomain",
                        ".example",
                        ".invalid",
                        ".localhost",
                        ".test",
                        ".local",
                        ".home.arpa",
                        ".msftconnecttest.com",
                        ".msftncsi.com"
                    ],
                    "invert": true
                },
                {
                    "query_type": [
                        "A",
                        "AAAA"
                    ]
                }
            ],
            "server": "dns-fakeip"
        },
        {
            "rule_set": "geosite-geolocation-!cn",
            "server": "dns-remote"
        }
    ],
    "final": "dns-remote"
},
