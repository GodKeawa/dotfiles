"rules": [
    {
        "type": "logical",
        "mode": "or",
        "rules": [
            {
                "protocol": "dns"
            },
            {
                "port": 53
            }
        ],
        "action": "hijack-dns"
    },
    {
        "ip_cidr": "{{ (bitwardenFields "item" "SINGBOX").server.value }}/32",
        "outbound": "direct"
    },
    {
        "rule_set": [
        "custom-direct",
        "geosite-private",
        "geosite-cn",
        "geoip-private",
        "geoip-cn"
        ],
        "outbound": "direct"
    },
    {
        "rule_set": [
            "custom-proxy",
            "geosite-geolocation-!cn"
        ],
        "outbound": "proxy"
    },
    {
        "rule_set": "category-ads-all",
        "outbound": "block"
    }
],
