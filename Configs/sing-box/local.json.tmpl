{
    "log": {
        "level": "info",
        "timestamp": true
    },
    "dns": {
        "strategy": "ipv4_only",
        "servers": [
            {
                "type": "hosts",
                "tag": "dns-godke-dev",
                "predefined": {
{{ includeTemplate "sing-box/dns-godke-dev.tmpl" . | indent 20 }}
                }
            },
            {
                "type": "fakeip",
                "tag": "dns-fakeip",
                "inet4_range": "198.18.0.0/15"
            },
            {
                "type": "https",
                "tag": "dns-local",
                "domain_resolver": "dns-local-resolver",
                "server": "dns.alidns.com",
                "path": "/dns-query"
            },
            {
                "type": "udp",
                "tag": "dns-local-resolver",
                "server": "223.5.5.5",
                "server_port": 53
            },
            {
                "type": "tls",
                "tag": "dns-remote",
                "detour": "proxy",
                "domain_resolver": "dns-local-resolver",
                "server": "8.8.8.8",
                "server_port": 853
            }
        ],
        "rules": [
            {
                "rule_set": "godke-dev",
                "server": "dns-godke-dev"
            },
            {
                "rule_set": "category-ads-all",
                "action": "reject"
            },
            {
                "rule_set": "custom-direct",
                "server": "dns-local"
            },
            {
                "rule_set": "custom-proxy",
                "server": "dns-remote"
            },
            {
                "rule_set": [
                    "geosite-private",
                    "geosite-cn"
                ],
                "server": "dns-local"
            },
            {
                "type": "logical",
                "mode": "and",
                "rules": [
                    {
                        "domain_suffix": [
                            ".lan",
                            ".localdomain",
                            ".example",
                            ".invalid",
                            ".localhost",
                            ".test",
                            ".local",
                            ".home.arpa",
                            ".msftconnecttest.com",
                            ".msftncsi.com"
                        ],
                        "invert": true
                    },
                    {
                        "query_type": [
                            "A",
                            "AAAA"
                        ]
                    }
                ],
                "server": "dns-fakeip"
            },
            {
                "rule_set": "geosite-geolocation-!cn",
                "server": "dns-remote"
            }
        ],
        "final": "dns-remote"
    },
    "inbounds": [
        {
            "type": "mixed",
            "tag": "mixed-in",
            "listen": "0.0.0.0",
            "listen_port": 7897,
            "tcp_fast_open": true,
            "tcp_multi_path": true,
            "udp_fragment": true
        }
    ],
    "outbounds": [
        {
            "type": "selector",
            "tag": "proxy",
            "outbounds": [
                "VPS",
                "direct"
            ],
            "interrupt_exist_connections": true
        },
        {
            "type": "vless",
            "tag": "VPS",
            "server": {{ (bitwardenFields "item" "SINGBOX").server.value | quote }},
            "server_port": {{ (bitwardenFields "item" "SINGBOX").server_port.value }},
            "uuid": {{ (bitwardenFields "item" "SINGBOX").uuid.value | quote }},
            "flow": {{ (bitwardenFields "item" "SINGBOX").flow.value | quote }},
            "tls": {
                "enabled": true,
                "server_name": {{ (bitwardenFields "item" "SINGBOX").tls_server_name.value | quote }},
                "utls": {
                    "enabled": true,
                    "fingerprint": {{ (bitwardenFields "item" "SINGBOX").tls_utls_fingerprint.value | quote }}
                },
                "reality": {
                    "enabled": true,
                    "public_key": {{ (bitwardenFields "item" "SINGBOX").tls_reality_public_key.value | quote }},
                    "short_id": {{ (bitwardenFields "item" "SINGBOX").tls_reality_short_id.value | quote }}
                }
            }
        },
        {
            "type": "direct",
            "tag": "direct"
        },
        {
            "type": "block",
            "tag": "block"
        }
    ],
    "route": {
        "rules": [
            {
                "type": "logical",
                "mode": "or",
                "rules": [
                    {
                        "protocol": "dns"
                    },
                    {
                        "port": 53
                    }
                ],
                "action": "hijack-dns"
            },
            {
                "rule_set": "godke-dev",
                "action": "resolve"
            },
            {
                "ip_cidr": "{{ (bitwardenFields "item" "SINGBOX").server.value }}/32",
                "outbound": "direct"
            },
            {
                "rule_set": [
                    "custom-direct",
                    "godke-dev",
                    "geosite-private",
                    "geosite-cn",
                    "geoip-private",
                    "geoip-cn"
                ],
                "outbound": "direct"
            },
            {
                "rule_set": [
                    "custom-proxy",
                    "geosite-geolocation-!cn"
                ],
                "outbound": "proxy"
            },
            {
                "rule_set": "category-ads-all",
                "outbound": "block"
            }
        ],
        "rule_set": [
            {
                "tag": "godke-dev",
                "rules": [
                    {
                        "domain_suffix": "godke.dev"
                    }
                ]
            },
            {
                "tag": "custom-direct",
                "rules": [
                    {
                        "domain_suffix": [
{{ includeTemplate "sing-box/custom-direct.tmpl" . | indent 28 }}
                        ]
                    }
                ]
            },
            {
                "tag": "custom-proxy",
                "rules": [
                    {
                        "domain_suffix": [
{{ includeTemplate "sing-box/custom-proxy.tmpl" . | indent 28 }}
                        ]
                    }
                ]
            },
            {
                "type": "remote",
                "tag": "category-ads-all",
                "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ads-all.srs",
                "http_client": {
                    "version": 2,
                    "detour": "proxy",
                    "stream_receive_window": 0,
                    "connection_receive_window": 0
                }
            },
            {
                "type": "remote",
                "tag": "geosite-private",
                "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs",
                "http_client": {
                    "version": 2,
                    "detour": "proxy",
                    "stream_receive_window": 0,
                    "connection_receive_window": 0
                }
            },
            {
                "type": "remote",
                "tag": "geoip-private",
                "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/private.srs",
                "http_client": {
                    "version": 2,
                    "detour": "proxy",
                    "stream_receive_window": 0,
                    "connection_receive_window": 0
                }
            },
            {
                "type": "remote",
                "tag": "geosite-cn",
                "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
                "http_client": {
                    "version": 2,
                    "detour": "proxy",
                    "stream_receive_window": 0,
                    "connection_receive_window": 0
                }
            },
            {
                "type": "remote",
                "tag": "geoip-cn",
                "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
                "http_client": {
                    "version": 2,
                    "detour": "proxy",
                    "stream_receive_window": 0,
                    "connection_receive_window": 0
                }
            },
            {
                "type": "remote",
                "tag": "geosite-geolocation-!cn",
                "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs",
                "http_client": {
                    "version": 2,
                    "detour": "proxy",
                    "stream_receive_window": 0,
                    "connection_receive_window": 0
                }
            }
        ],
        "final": "proxy",
        "auto_detect_interface": true,
        "default_domain_resolver": "dns-local"
    },
    "experimental": {
        "cache_file": {
            "enabled": true,
            "path": "cache.db",
            "store_fakeip": true,
            "rdrc_timeout": "168h0m0s"
        }
    }
}
